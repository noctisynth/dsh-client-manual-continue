{
  "name": "dsh-client-manual-continue",
  "version": "0.0.0",
  "description": "Manual continuation plugin for DSH",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "exports": {
    ".": {
      "types": "./src/host/index.ts",
      "default": "./lib/host/index.js"
    },
    "./types": {
      "types": "./src/shared/protocol.ts",
      "default": "./dist/protocol.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/host/index.js",
    "dist/protocol.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src/**/*.ts",
    "lib/client/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "typecheck": "node scripts/generate-remote.ts && tsrs --project tsconfig.host.json && tsrs --project tsconfig.client.json && tsrs --project tsconfig.client-tests.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsdown && node scripts/generate-remote.ts && tsdown --config tsdown.client.config.ts && node --test --test-isolation=none test/*.test.ts test/client/*.test.ts",
    "build": "tsdown && node scripts/generate-remote.ts && tsdown --config tsdown.client.config.ts",
    "check": "tsdown && node scripts/generate-remote.ts && tsdown --config tsdown.client.config.ts && tsrs --project tsconfig.host.json && tsrs --project tsconfig.client.json && tsrs --project tsconfig.client-tests.json && biome check . && node --test --test-isolation=none test/*.test.ts test/client/*.test.ts",
    "changeset": "smif commit",
    "release:check": "smif config sync --check",
    "release:status": "smif status",
    "release:version": "smif version",
    "release:publish": "smif publish"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-job-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-terminal-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-cordis-client-runner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-file-reference": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-retry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-native-command": "0.2.2-rc.1",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-reference": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-file-drag": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@shikijs/langs": "4.4.3",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.0",
    "@types/react": "18.3.27",
    "jsdom": "31.0.0",
    "lexical": "0.49.0",
    "react": "18.3.1",
    "tsdown": "0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
